{
  "name": "riftbound-proxy-studio",
  "version": "0.2.0",
  "private": true,
  "description": "A private desktop prototype for preparing Riftbound proxy projects for PDF and MakePlayingCards.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --win nsis portable",
    "pack:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@piltoverarchive/riftbound-deck-codes": "1.4.0",
    "adm-zip": "0.6.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "24.7.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "studio.riftbound.proxy",
    "productName": "Riftbound Proxy Studio",
    "asar": true,
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
